# SYNAPSEED Benchmark Suite — Environment Configuration
# Copy to .env and adjust for your local setup.
#
# .env is already in .gitignore — your keys stay local.

# ── Primary LLM Endpoint ────────────────────────────────────────────
# Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen/qwen3-1.7b

# LM Studio:
# LLM_BASE_URL=http://192.168.100.7:1234/v1
# LLM_API_KEY=lm-studio

# OpenRouter (remote, metered):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...

# ── Secondary Endpoint (failover) ───────────────────────────────────
# If primary is down, client automatically retries on secondary.
# LLM_BASE_URL_2=http://192.168.100.55:1234/v1
# LLM_API_KEY_2=lm-studio

# ── Multi-Model Runs ────────────────────────────────────────────────
# Comma-separated list of models to benchmark in a single run.
# If set, overrides LLM_MODEL and runs each benchmark per model.
# LLM_MODELS=lfm2.5-1.2b-instruct-mlx,llama-3.2-1b-instruct,qwen/qwen3-1.7b

# ── LLM Parameters ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120

# ── Synapseed ────────────────────────────────────────────────────────
# Model tier override (auto-detected if not set):
# SYNAPSEED_MODEL_TIER=atomic
