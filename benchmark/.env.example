# SYNAPSEED Benchmark Suite — Environment Configuration
# Copy to .env and adjust for your local setup.
#
# .env is already in .gitignore — your keys stay local.

# ── LLM Endpoint ─────────────────────────────────────────────────────
# Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:1.7b

# LM Studio:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio

# OpenRouter (remote, metered):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3-1.7b

# ── LLM Parameters ───────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120

# ── Synapseed ────────────────────────────────────────────────────────
# Model tier override (auto-detected if not set):
# SYNAPSEED_MODEL_TIER=atomic
